{
    "name": "uams-web/ar-biosciences-pro",
    "description": "AR Biosciences Pro, a Genesis child theme. Development-only: the theme ships without Composer.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "pest",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "test": "Run the test suite (the Unit suite only; no Integration suite exists yet).",
        "test:unit": "Run the Pest suite that needs no WordPress and no database."
    }
}
